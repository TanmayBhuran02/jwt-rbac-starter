# Security
SECRET_KEY=change-me-to-at-least-32-characters-long
REFRESH_SECRET_KEY=another-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:root@localhost:5432/auth_db

# Test Database — REQUIRED by pytest. The suite does NOT fall back to SQLite;
# it fails fast with setup instructions if this database is unreachable.
# One-time setup:  createdb -h localhost -U postgres jwt_rbac_test
TEST_DATABASE_URL=postgresql://postgres:root@localhost:5432/jwt_rbac_test

# Redis (optional — enables Redis token blacklist)
REDIS_URL=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT Issuer (optional — validates iss claim when set)
JWT_ISSUER=

# Seed Script — default admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
